<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webforge_chooser_card_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/webforge_chooser_brand_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/webforge_chooser_card" />
            <stroke
                android:width="1dp"
                android:color="@color/webforge_chooser_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
